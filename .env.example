# Copy to .env (gitignored) and change every password.
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=mealdeck
DB_PASSWORD=change-me
# Host port nginx listens on; http://localhost:80 by default.
HOST_PORT=80

# Email (account sign-up codes) via Resend: https://resend.com/api-keys
# The sending domain must be verified in Resend (Domains -> add mealdeck.in
# and put its DNS records in Cloudflare). Leave the key empty and codes are
# only written to the backend log, which is fine for local dev.
RESEND_API_KEY=<resend api key>
MAIL_FROM=MealDeck <noreply@mealdeck.in>
